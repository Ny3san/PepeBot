# Copie este arquivo para .env e preencha os valores.

# Token do bot (Discord Developer Portal > Bot > Reset Token). Obrigatorio.
CLOWN_TOKEN=

# Opcional: registra os comandos apenas neste servidor (sincronizacao instantanea).
# Vazio = comandos globais (podem levar ate 1h para aparecer).
CLOWN_GUILD_ID=

# Opcional: IDs de usuario Discord com bypass administrativo total (separados por virgula).
BYPASS_USER_IDS=
